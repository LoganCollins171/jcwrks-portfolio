---
import { text } from "../lib/copy";
---
<section data-hero class="relative min-h-[100svh] flex items-end overflow-hidden">
  <!-- restrained purple light behind the subject (on-brand, not loud) -->
  <div
    class="pointer-events-none absolute left-1/2 top-[44%] sm:top-[48%] -translate-x-1/2 -translate-y-1/2 w-[88vw] sm:w-[75vw] max-w-2xl aspect-square rounded-full blur-[120px] opacity-[0.16]"
    style="background: radial-gradient(circle, #8b5cf6 0%, transparent 68%);"
  >
  </div>

  <!-- Jacob — B&W cutout, big. Taller than the viewport and shifted DOWN so his
       head stays in frame while the crop lands below the fold: full-body-small
       became chest-up-large (Jacob asked for ~2x). The translate must pair with
       the height (translate = height − 100svh) or his head clips at the top. -->
  <div class="hero-load absolute inset-0 flex items-end justify-center">
    <!-- translate = height − 100svh + ~4svh headroom, so his head rests just
         below the section top (the entrance zoom overshoots scale 1.14 while
         still mostly transparent, so the brief extra lift never reads).
         Mobile stays gentler so his head clears the nav bar on phones.
         (Jacob's tuning: sizes 95/120/140 -> 88/110/125 -> 84/103/115 ->
         80/97/107, then "too tall" — so the translates got bigger WITHOUT a
         size change: sliding him down drops his head to ~11svh (under the
         nav, where the original had it) and shortens the visible figure
         while keeping his width. Height & translate move TOGETHER or he clips.) -->
    <div data-hero-scroll class="relative will-change-transform flex items-end justify-center translate-y-[3svh] sm:translate-y-[8svh] lg:translate-y-[18svh]">
      <!-- blurred echo so the bottom edge melts instead of cutting hard -->
      <img src="/jacob-hero-bw.png" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-auto mx-auto blur-2xl opacity-60 hero-mask-bottom" />
      <!-- sharp subject, bottom faded -->
      <img src="/jacob-hero-bw.png" alt="Jacob Combs, freelance photographer" class="relative h-[80svh] sm:h-[97svh] lg:h-[107svh] w-auto object-contain hero-mask-fade" />
    </div>
  </div>

  <!-- strong white base at the bottom so the headline + kicker are always legible -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[55%] z-[5]"
    style="background: linear-gradient(to top, #ffffff 0%, #ffffff 22%, rgba(255,255,255,0.78) 42%, rgba(255,255,255,0) 100%);"
  >
  </div>

  <!-- foreground content -->
  <div class="relative z-10 w-full">
    <div class="mx-auto max-w-[1400px] px-6 sm:px-10 pb-12 sm:pb-16">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 lg:gap-10">
        <div class="relative inline-block">
          <p class="hero-rise text-accent font-medium tracking-[0.28em] uppercase text-[10px] sm:text-[11px] mb-3 sm:mb-5 flex items-center gap-3" style="--d:200ms">
            <span class="h-px w-6 sm:w-7 bg-accent inline-block"></span> {text("home.hero.kicker")}
          </p>
          <h1 class="font-display font-medium leading-[0.9] tracking-[-0.02em] text-5xl sm:text-7xl lg:text-[7rem]">
            <span class="hero-rise-line"><span class="hero-rise-inner" style="--d:320ms">Jacob Combs</span></span>
          </h1>
          <!-- DESKTOP (sm:/lg:) values are the previously-approved good ones — DO NOT CHANGE.
               Only the unprefixed (mobile) values are tuned for phones. -->
          <img src="/jacob-signature.png" alt="Jacob Combs signature" data-sign class="sign-write -mt-5 sm:-mt-9 lg:-mt-12 ml-[22%] sm:ml-[34%] h-20 sm:h-28 lg:h-36 w-auto relative z-10" />
        </div>

        <div class="max-w-xs lg:text-right lg:pb-3">
          <p class="hero-rise text-fog leading-relaxed mb-5 sm:mb-7 text-[14px] sm:text-[15px]" style="--d:620ms">
            {text("home.hero.intro")}
          </p>
          <div class="hero-rise flex flex-wrap gap-3 lg:justify-end" style="--d:780ms">
            <a href="/photo-video" class="btn btn-solid px-6 py-2.5 text-sm">View Work</a>
            <a href="/contact" class="btn btn-outline px-6 py-2.5 text-sm">Book</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-4 sm:bottom-8 left-1/2 -translate-x-1/2 text-bone/30 z-10 hidden sm:block">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9" /></svg>
  </div>
</section>
